generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model auction {
  id                Int            @id @default(autoincrement())
  listingId         Int            @unique(map: "Auction_listingId_key")
  startingBid       Float
  currentBid        Float
  endDate           DateTime
  createdAt         DateTime       @default(now())
  buyNowPrice       Float?
  inspectionAddress String?
  inspectionCity    String?
  inspectionDate    DateTime?
  inspectionState   String?
  minimumIncrement  Float          @default(1000)
  paymentTerms      String?        @db.Text
  reservePrice      Float?
  startDate         DateTime
  status            auction_status @default(SCHEDULED)
  terms             String?        @db.Text
  updatedAt         DateTime
  winnerId          Int?
  listing           listing        @relation(fields: [listingId], references: [id], map: "Auction_listingId_fkey")
  user              user?          @relation(fields: [winnerId], references: [id], map: "Auction_winnerId_fkey")
  bid               bid[]
  notification      notification[]

  @@index([winnerId], map: "Auction_winnerId_fkey")
}

model bid {
  id        Int      @id @default(autoincrement())
  amount    Float
  auctionId Int
  createdAt DateTime @default(now())
  userId    Int
  auction   auction  @relation(fields: [auctionId], references: [id], map: "Bid_auctionId_fkey")
  user      user     @relation(fields: [userId], references: [id], map: "Bid_bidderId_fkey")

  @@index([auctionId], map: "Bid_auctionId_fkey")
  @@index([userId], map: "Bid_bidderId_fkey")
}

model category {
  id             Int        @id @default(autoincrement())
  name           String
  parentId       Int?
  category       category?  @relation("categoryTocategory", fields: [parentId], references: [id], map: "Category_parentId_fkey")
  other_category category[] @relation("categoryTocategory")
  listing        listing[]

  @@index([parentId], map: "Category_parentId_fkey")
}

model equipmentDetails {
  id                  Int     @id @default(autoincrement())
  listingId           Int     @unique(map: "EquipmentDetails_listingId_key")
  model               String?
  year                Int?
  mechanicalCondition String?
  hydraulicCondition  String?
  brand               String?
  bucketCapacity      String?
  city                String?
  condition           String?
  operatingHours      Int?
  serialNumber        String?
  state               String?
  listing             listing @relation(fields: [listingId], references: [id], map: "EquipmentDetails_listingId_fkey")
}

model favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  listingId Int
  createdAt DateTime @default(now())
  listing   listing  @relation(fields: [listingId], references: [id], map: "Favorite_listingId_fkey")
  user      user     @relation(fields: [userId], references: [id], map: "Favorite_userId_fkey")

  @@unique([userId, listingId], map: "Favorite_userId_listingId_key")
  @@index([listingId], map: "Favorite_listingId_fkey")
}

model listing {
  id               Int               @id @default(autoincrement())
  title            String
  description      String
  price            Float
  isAuction        Boolean           @default(false)
  sellerId         Int
  categoryId       Int
  isApproved       Boolean           @default(false)
  createdAt        DateTime          @default(now())
  rejectReason     String?
  status           String            @default("PENDING")
  isSold           Boolean           @default(false)
  soldAt           DateTime?
  auction          auction?
  equipmentDetails equipmentDetails?
  favorite         favorite[]
  category         category          @relation(fields: [categoryId], references: [id], map: "Listing_categoryId_fkey")
  user             user              @relation(fields: [sellerId], references: [id], map: "Listing_sellerId_fkey")
  listingimage     listingimage[]
  notification     notification[]
  propertyDetails  propertyDetails?
  quarryDetails    quarryDetails?
  review           review[]
  sparepartDetails sparepartDetails?
  listingView listingView[]

  @@index([categoryId], map: "Listing_categoryId_fkey")
  @@index([sellerId], map: "Listing_sellerId_fkey")
}

model listingimage {
  id        Int     @id @default(autoincrement())
  imageUrl  String
  listingId Int
  listing   listing @relation(fields: [listingId], references: [id], map: "ListingImage_listingId_fkey")

  @@index([listingId], map: "ListingImage_listingId_fkey")
}

model notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  message   String
  type      String?
  listingId Int?
  auctionId Int?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  auction   auction? @relation(fields: [auctionId], references: [id], map: "Notification_auctionId_fkey")
  listing   listing? @relation(fields: [listingId], references: [id], map: "Notification_listingId_fkey")
  user      user     @relation(fields: [userId], references: [id], map: "Notification_userId_fkey")

  @@index([auctionId], map: "Notification_auctionId_fkey")
  @@index([listingId], map: "Notification_listingId_fkey")
  @@index([userId], map: "Notification_userId_fkey")
}

model propertyDetails {
  id            Int      @id @default(autoincrement())
  listingId     Int      @unique(map: "PropertyDetails_listingId_key")
  propertyType  String?
  bedrooms      Int?
  bathrooms     Int?
  plotSize      Float?
  titleDocument String?
  address       String?
  city          String?
  factorySize   Float?
  floors        Int?
  officeSpace   Boolean?
  parkingSpaces Int?
  plotUnit      String?
  powerSupply   String?
  roadAccess    Boolean?
  state         String?
  warehouseSize Float?
  listing       listing  @relation(fields: [listingId], references: [id], map: "PropertyDetails_listingId_fkey")
}

model quarryDetails {
  id                 Int     @id @default(autoincrement())
  listingId          Int     @unique(map: "QuarryDetails_listingId_key")
  quarryType         String?
  reserveEstimate    Float?
  productionCapacity String?
  miningLicense      String?
  city               String?
  state              String?
  listing            listing @relation(fields: [listingId], references: [id], map: "QuarryDetails_listingId_fkey")
}

model review {
  id                         Int      @id @default(autoincrement())
  rating                     Int
  comment                    String
  sellerId                   Int
  buyerId                    Int
  createdAt                  DateTime @default(now())
  listingId                  Int
  user_review_buyerIdTouser  user     @relation("review_buyerIdTouser", fields: [buyerId], references: [id], map: "Review_buyerId_fkey")
  listing                    listing  @relation(fields: [listingId], references: [id], map: "Review_listingId_fkey")
  user_review_sellerIdTouser user     @relation("review_sellerIdTouser", fields: [sellerId], references: [id], map: "Review_sellerId_fkey")

  @@unique([buyerId, listingId], map: "Review_buyerId_listingId_key")
  @@index([listingId], map: "Review_listingId_fkey")
  @@index([sellerId], map: "Review_sellerId_fkey")
}

model sparepartDetails {
  id         Int     @id @default(autoincrement())
  listingId  Int     @unique(map: "SparePartDetails_listingId_key")
  partName   String?
  brand      String?
  model      String?
  partNumber String?
  condition  String?
  quantity   Int?
  state      String?
  city       String?
  listing    listing @relation(fields: [listingId], references: [id], map: "SparePartDetails_listingId_fkey")
}

model listingView {
  id        Int      @id @default(autoincrement())
  listingId Int
  createdAt DateTime @default(now())

  listing listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, createdAt])
}

model user {
  id                           Int            @id @default(autoincrement())
  name                         String
  avatar                       String?
  email                        String         @unique(map: "User_email_key")
  password                     String
  role                         user_role      @default(BUYER)
  isApproved                   Boolean        @default(false)
  createdAt                    DateTime       @default(now())
  phone                        String?
  whatsapp                     String?
  isEmailVerified              Boolean        @default(false)
  verificationCode             String?
  about                        String?
  companyName                  String?
  location                     String?
  auction                      auction[]
  bid                          bid[]
  favorite                     favorite[]
  listing                      listing[]
  notification                 notification[]
  review_review_buyerIdTouser  review[]       @relation("review_buyerIdTouser")
  review_review_sellerIdTouser review[]       @relation("review_sellerIdTouser")
}

enum user_role {
  ADMIN
  SELLER
  BUYER
}

enum auction_status {
  SCHEDULED
  LIVE
  ENDED
  SOLD
  CANCELLED
}
